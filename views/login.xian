<!DOCTYPE html><html lang="en">{{> head}}<body>{{> navbar}}<main class="auth-wrap"><form class="panel auth-panel" method="POST" action="/login"><p class="eyebrow">WELCOME BACK</p><h1>Sign in</h1>{{#if notice}}<div class="notice">{{notice}}</div>{{/if}}<label>Email<input type="email" name="email" required></label><label>Password<input type="password" name="password" required></label><button class="btn btn-primary full" type="submit">Login</button><p class="muted">No account? <a href="/register">Create one</a></p></form></main>{{> foot}}</body></html>