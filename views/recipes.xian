<!DOCTYPE html><html lang="en">{{> head}}<body>{{> navbar}}<main class="container"><div class="page-title"><p class="eyebrow">RECIPE SETUP</p><h1>Product recipes</h1><p>Set the ingredient quantity used for one serving. These quantities are deducted when an order is placed.</p></div>{{#if notice}}<div class="notice">{{notice}}</div>{{/if}}<section class="panel"><h2>Add recipe ingredient</h2><form class="form-grid" method="POST" action="/recipes"><label>Product<select name="productId" required>{{#each products}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Ingredient<select name="ingredientId" required>{{#each ingredients}}<option value="{{id}}">{{name}} ({{unit}})</option>{{/each}}</select></label><label>Quantity per serving<input type="number" name="quantityUsed" min="0.001" step="0.001" required></label><div><button class="btn btn-primary">Add to recipe</button></div></form></section>{{#each products}}<section class="panel"><h2>{{name}}</h2><div class="table-wrap"><table><thead><tr><th>Ingredient</th><th>Quantity per serving</th><th></th></tr></thead><tbody>{{#each Recipes}}<tr><td>{{Ingredient.name}}</td><td>{{quantityUsed}} {{Ingredient.unit}}</td><td><form method="POST" action="/recipes/{{id}}/delete"><button class="btn btn-small btn-outline">Remove</button></form></td></tr>{{else}}<tr><td colspan="3">No recipe ingredients set.</td></tr>{{/each}}</tbody></table></div></section>{{else}}<section class="panel">Add products first before setting recipes.</section>{{/each}}</main>{{> foot}}</body></html>