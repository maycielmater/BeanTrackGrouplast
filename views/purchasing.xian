<!DOCTYPE html><html lang="en">{{> head}}<body>{{> navbar}}<main class="container"><div class="page-title"><p class="eyebrow">SUPPLY MANAGEMENT</p><h1>Purchasing</h1><p>Maintain supplier details and record received ingredient purchases.</p></div>{{#if notice}}<div class="notice">{{notice}}</div>{{/if}}<section class="panel"><h2>Add supplier</h2><form class="form-grid" method="POST" action="/suppliers"><label>Supplier name<input name="name" required></label><label>Contact person<input name="contactPerson"></label><label>Phone<input name="phone"></label><label>Email<input type="email" name="email"></label><label class="span2">Address<input name="address"></label><div><button class="btn btn-primary">Save supplier</button></div></form></section><section class="panel"><h2>Record received purchase</h2><form class="form-grid" method="POST" action="/purchases"><label>Supplier<select name="supplierId"><option value="">Not specified</option>{{#each suppliers}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Ingredient<select name="ingredientId" required>{{#each ingredients}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Quantity received<input type="number" name="quantity" min="0.001" step="0.001" required></label><label>Total cost (₱)<input type="number" name="totalCost" min="0" step="0.01" required></label><label class="span2">Notes<input name="notes"></label><div><button class="btn btn-primary">Record purchase + stock in</button></div></form></section><section class="panel"><h2>Purchase history</h2><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Date</th><th>Supplier</th><th>Ingredient</th><th>Quantity</th><th>Total cost</th></tr></thead><tbody>{{#each purchases}}<tr><td>{{referenceNo}}</td><td>{{formatDate createdAt}}</td><td>{{Supplier.name}}</td><td>{{Ingredient.name}}</td><td>{{quantity}}</td><td>{{currency totalCost}}</td></tr>{{else}}<tr><td colspan="6">No purchases recorded.</td></tr>{{/each}}</tbody></table></div></section></main>{{> foot}}</body></html>